<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="@color/card_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title & Category Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDuaTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/ffon1"
                android:textColor="@color/text_gold"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="دعاء الهداية والقبول" />

            <TextView
                android:id="@+id/tvCategoryBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_modern"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                tools:text="أدعية القرآن" />
        </LinearLayout>

        <!-- Main Content (Arabic Text) -->
        <TextView
            android:id="@+id/tvDuaContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/uthmanii"
            android:lineSpacingExtra="6dp"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            tools:text="رَبَّنَا تَقَبَّلْ مِنَّا إِنَّكَ أَنْتَ السَّمِيعُ الْعَلِيمُ" />

        <!-- Source & Benefit -->
        <TextView
            android:id="@+id/tvDuaSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/jazeera"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:text="سورة البقرة [127 - 128]" />

        <TextView
            android:id="@+id/tvDuaBenefit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/jazeera"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="من الأدعية القرآنية المباركة"
            tools:visibility="visible" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/card_stroke" />

        <!-- Action Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Counter Badge / Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCounter"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:paddingHorizontal="12dp"
                android:textColor="@color/colorPrimary"
                android:textSize="13sp"
                app:cornerRadius="18dp"
                app:strokeColor="@color/colorPrimary"
                tools:text="التكرار: 3" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Favorite Button -->
            <ImageButton
                android:id="@+id/btnFavorite"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="حفظ في المفضلة"
                android:src="@drawable/ic_favorite_outline" />

            <!-- Copy Button -->
            <ImageButton
                android:id="@+id/btnCopy"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="نسخ الدعاء"
                android:src="@drawable/ic_copy" />

            <!-- Share Button -->
            <ImageButton
                android:id="@+id/btnShare"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="مشاركة الدعاء"
                android:src="@drawable/ic_share" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
